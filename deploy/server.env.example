# Docker Compose configuration. Copy to server.env using the init script.
VITIS_PORT=5182
VITIS_BIND_ADDRESS=0.0.0.0
VITIS_IMAGE_TAG=local
# Origin only, WITHOUT a trailing slash/path. These URLs are reached by Nginx.
# host.docker.internal targets the Docker host, not the user's browser.
PROJECT_UPSTREAM=http://host.docker.internal:8500
IDENTITY_UPSTREAM=http://host.docker.internal:8430
GATEWAY_UPSTREAM=http://host.docker.internal:8084
NOTIFICATION_UPSTREAM=http://host.docker.internal:8700
TODO_UPSTREAM=http://host.docker.internal:8650
REGISTRY_UPSTREAM=http://host.docker.internal:8405
CONNECTOR_UPSTREAM=http://host.docker.internal:8400
DATASET_UPSTREAM=http://host.docker.internal:8600
BASE_MODEL_UPSTREAM=http://host.docker.internal:8502
